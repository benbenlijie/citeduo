# Copy to deploy/opencode.env (chmod 600) on the host. NEVER commit the real file.
#
# Only these values are passed into the opencode container. Keep LLM_PROVIDERS on
# one line; it is the same JSON array as server/.env.
LLM_PROVIDERS=[{"name":"mtcode","kind":"openai","baseUrl":"https://your-provider/v1","apiKey":"sk-xxx","model":"your-model"}]

# Must equal INTERNAL_TOKEN in server/.env. If the app generated a random one
# per boot (INTERNAL_TOKEN unset), set it explicitly on both sides.
PAPER_INTERNAL_TOKEN=replace-with-the-same-value-as-server-env

# Must equal OPENCODE_SERVER_PASSWORD in server/.env.
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-password
