{
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "server": "bun --env-file=server/.env run server/main.ts",
    "opencode:local": "bun --env-file=server/.env run scripts/opencode-local.ts",
    "test:server": "S2_MIN_INTERVAL_MS=0 ARXIV_API_MIN_INTERVAL_MS=0 ARXIV_CONTENT_MIN_INTERVAL_MS=0 bun test server/",
    "typecheck:server": "bunx tsc --noEmit -p server/tsconfig.json",
    "dev:web": "pnpm --dir academic-paper-explorer dev",
    "build:web": "pnpm --dir academic-paper-explorer build",
    "deploy": "bash scripts/deploy.sh",
    "check:politeness": "bun run scripts/check-politeness-floors.ts",
    "test:politeness": "bun test scripts/check-politeness-floors.test.ts",
    "typecheck:politeness": "bunx tsc --noEmit -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "dependencies": {
    "unpdf": "1.8.1"
  }
}
