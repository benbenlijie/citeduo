# 复制为 server/.env 后按需填写：cp server/.env.example server/.env
# （scripts/setup.sh 会自动完成这一步）

# Semantic Scholar API Key（可选）。留空则使用共享配额；填写后为独立 1 req/s。
# 申请：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# 联系邮箱：用于 API User-Agent（OpenAlex 礼貌通道）。建议填真实邮箱。
CONTACT_EMAIL=you@example.com

# OpenAlex API key（可选）。配置后摆脱匿名搜索限流，获得更高配额。
# 申请：https://openalex.org/rest-api
OPENALEX_API_KEY=

# 上游请求最小间隔（毫秒，可选）。S2 默认 1000ms（有无 key 相同）；OpenAlex 默认 200ms。
# S2_MIN_INTERVAL_MS=1000
# OPENALEX_MIN_INTERVAL_MS=200

# 服务端口，默认 8787。
PORT=8787

# 公网部署（可选）。设置后所有请求都需要口令；本地留空则完全不鉴权。
# 首次用 https://你的域名/?token=你的口令 打开一次，之后写入 Cookie。
ACCESS_TOKEN=
# 若在反向代理（nginx/Caddy）之后，设为 1 以信任 X-Forwarded-For 来识别真实 IP。
TRUST_PROXY=0
# 每 IP 每分钟 /api/* 请求上限（0 关闭）。默认 120。
RATE_LIMIT_PER_MIN=120

# 使用统计（可选）。默认开启，写入 data/app.db 的 usage_events 表。
# 看板地址：/stats（子路径部署时 /papers/stats）。默认复用 ACCESS_TOKEN。
# 想给看板单独口令就设置 ADMIN_TOKEN，然后打开 /stats?token=... 一次。
# ANALYTICS_ENABLED=0
# ADMIN_TOKEN=

# 公开 demo（可选）。把站点开放给外网时务必同时设置 ADMIN_TOKEN。
# ACCESS_TOKEN 留空 / 删除，DEMO_PUBLIC=1 后应用无需口令；/stats 和 /api/admin/* 仍要 ADMIN_TOKEN。
# DEMO_PUBLIC=1
# 每日预算：HTML 导航 + API 请求，不含静态资源。0 表示不限制。
# DEMO_DAILY_REQUEST_LIMIT=5000
# DEMO_DAILY_VISITOR_LIMIT=300
# 超限后是直接 429（默认），还是只报警不拦截（0）。
# DEMO_BLOCK_ON_LIMIT=1
# 报警 webhook：支持 generic / slack / discord / feishu 格式。
# DEMO_ALERT_WEBHOOK=
# DEMO_ALERT_FORMAT=generic

# 报警邮件（可选）。QQ 邮箱要在「设置 → 账号 → POP3/SMTP」开启 SMTP 并生成授权码，
# 不能直接用 QQ 登录密码。SMTP_PASS 填授权码。
# DEMO_ALERT_EMAIL=you@example.com
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=you@qq.com
# SMTP_PASS=你的QQ邮箱授权码
# SMTP_FROM=you@qq.com
# 公开 demo 默认保留全部功能（全文 + 服务端 AI/翻译）；每日预算仍然生效。
# 若想降低 arXiv 条款或 LLM 账单风险，再改成下面这套安全配置：
# PAPER_CONTENT_MODE=off
# LLM_PROVIDERS=[{"name":"browser","kind":"browser"}]
# OPENCODE_ENABLED=0

# 相关性扩展（多源相关边）调优，可选。
# RELATED_RECOMMEND_LIMIT=10   # S2 语义推荐取前 N
# RELATED_NODE_BUDGET=15       # 相关来源额外加入的节点上限
# COUPLING_MIN=2               # 文献耦合最小共享参考文献数
# OPENALEX_RELATED_LIMIT=10    # OpenAlex 相关作品取前 N
# EMBEDDING_BATCH=100          # 每次构建最多补取的向量数
# EMBEDDING_K=5                # 语义近邻 k
# EMBEDDING_MIN_SIM=0.8        # 语义边的最小余弦相似度

# 「两篇论文如何关联」检索（/api/connect）调优，可选。
# 顺序：先查本地已存关系 → 再双向联网扩展 → 仍无结构关系时回退语义相似度。
# CONNECT_MAX_EXPANSIONS=6         # 联网扩展的批量取数次数上限
# CONNECT_BATCH_SIZE=30            # 每次扩展取多少篇论文
# CONNECT_FRONTIER_LIMIT=60        # 单轮候选前沿上限
# CONNECT_REF_LIMIT=40             # 每篇展开论文保留的参考文献数
# CONNECT_CITE_LIMIT=25            # 每篇展开论文保留的引用者数
# CONNECT_MAX_HOPS=6               # 关联路径最大跳数
# CONNECT_MAX_PATHS=3              # 最多返回几条备选路径
# CONNECT_MAX_MS=25000             # 单次检索墙钟时间上限
# CONNECT_SEMANTIC_MIN_SIM=0.75    # 判定语义关联的最小余弦相似度
# CONNECT_LOCAL_ONLY=1             # 设为 1 完全离线，只走 SQLite 已存关系

# 阅读器与 arXiv 使用条款（可选，但公开部署请务必看一眼）。
# 应用内阅读器可以显示论文全文，而 arXiv 条款只允许「为你个人使用或研究目的」存储和提供
# e-print 内容：https://info.arxiv.org/help/api/tou.html
#   auto = 按 HOST 自动判定（默认）：仅回环实例为 full，其他为 off
#   full = 抓取并缓存全文（需自行确认符合 arXiv 条款；当前公开 demo 使用）
#   off  = 只返回摘要 + 元数据 + 原文链接，不写任何缓存（更保守的选择）
# PAPER_CONTENT_MODE=auto

# arXiv API 条款明文要求「每 3 秒最多一个请求，且只用一条连接」，不要调低于 3000。
# ARXIV_API_MIN_INTERVAL_MS=3000

# 论文页（HTML/PDF）抓取的最小间隔与每小时上限。
# robots.txt 的 Crawl-delay 是 15 秒，但那是写给爬虫的：这里每次只在用户打开某篇论文时抓一页
# 并缓存，不会遍历站点，所以用 1000ms + 每小时 60 页做礼貌兜底。要严格照字面执行可设 15000，
# 若不想承担公开提供全文的条款风险，可显式设置 PAPER_CONTENT_MODE=off。
# ARXIV_CONTENT_MIN_INTERVAL_MS=1000
# ARXIV_CONTENT_MAX_PER_HOUR=60

# off 模式下内存中保留的摘要条数上限（CC0 元数据）。超出后按插入顺序淘汰最旧的一条。0 关闭缓存；非数字回退为 500。
# ABSTRACT_MEMO_MAX=500

# 引用侧的补充抓取上限（可选）。批量接口自带的引用列表最多返回 1000 条（约 200KB/篇），
# 而调用方最多只用 25 条，因此改为按需限量抓取；这里限制每轮爬取为多少篇论文补充引用侧。
# CRAWL_CITE_FETCH_LIMIT=20

# 数据库路径（可选）。默认 data/app.db；Docker 镜像中为 /data/app.db。
# DB_PATH=/data/app.db

# 排障（可选）：设为 1 时 /api/connect 会把各阶段耗时写进服务端日志，用来判断慢在网络还是本地。
# CONNECT_TRACE=1

# LLM providers（翻译 / AI 辅助）。JSON 数组，数组顺序 = 优先级，失败自动降级到下一个。
# kind: "openai" = OpenAI 兼容 Chat Completions（mtcode / DeepSeek / OpenAI / Ollama 均可用）。
# kind: "browser" = 浏览器内置 Translator API，由前端本地执行，无需 key。
# 未配置时翻译接口返回 LLM_UNAVAILABLE。
# LLM_PROVIDERS=[{"name":"mtcode","kind":"openai","baseUrl":"https://your-mtcode-endpoint/v1","apiKey":"sk-xxx","model":"mtcode/deepseek-flash"},{"name":"browser","kind":"browser"}]
LLM_PROVIDERS=
